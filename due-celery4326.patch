+static int shell_quote(char *out, size_t outlen, const char *value) {
+    size_t used = 0;
+    if (outlen < 3) return 0;
+    out[used++] = '\'';
+    for (const char *p = value; *p; p++) {
+        if (used + (*p == '\'' ? 4U : 1U) >= outlen) return 0;
+        if (*p == '\'') {
+            out[used++] = '\''; out[used++] = '\\';
+            out[used++] = '\''; out[used++] = '\'';
+        } else out[used++] = *p;
+    }
+    if (used + 2 > outlen) return 0;
+    out[used++] = '\''; out[used] = '\0';
+    return 1;
+}
